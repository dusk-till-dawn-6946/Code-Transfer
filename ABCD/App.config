<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6" />
  </startup>

  <connectionStrings>
    <!--Production Connection-->


    <!--<add name="OraConnGatepass" connectionString="Data Source = (DESCRIPTION = (ADDRESS_LIST =(ADDRESS = (PROTOCOL = TCP)(HOST = 176.0.0.109)(PORT = 1521)))(CONNECT_DATA =(SID =acsrprd)));Persist Security Info=True;User Id=hrace;Password=abc123;" providerName="System.Data.OracleClient" />-->

    <!--Test Connection-->


    <add name="OraConnGatepass" connectionString="Data Source = (DESCRIPTION = (ADDRESS_LIST =(ADDRESS = (PROTOCOL = TCP)(HOST = 176.0.0.105)(PORT = 1521)))(CONNECT_DATA =(SID =hraceqa)));Persist Security Info=True;User Id=hrace;Password=hrace2012;" providerName="System.Data.OracleClient"/>
  </connectionStrings>

  <appSettings>
    <!-- ===================== Attendance scope ===================== -->
    <!-- Company / location (CMP_COMPANY_CODE) the batch reports for -->
    <add key="LocationCode" value="4600" />
    <!-- Optional CSV of department codes. Blank = every department of the location -->
    <add key="DepartmentCodes" value="" />
    <!-- Optional vendor code filter. Blank = all vendors -->
    <add key="VendorCode" value="" />

    <!-- ===================== Shift / attendance day ===================== -->
    <!-- Attendance day rolls over at this hour (same as p_cutoff_hour in frmTimekeeper) -->
    <add key="CutoffHour" value="5" />
    <!-- An 'In' punch within this many hours of the previous 'In' is treated as the same segment -->
    <add key="PunchGapHours" value="9" />

    <!-- ===================== Violation thresholds (hours) ===================== -->
    <!-- Inside premises >= OverstayHighHours  -> VIOTYPE1 (overstay, high concern) -->
    <add key="OverstayHighHours" value="12" />
    <!-- Inside premises >= OverstayMediumHours and < OverstayHighHours -> VIOTYPE4 -->
    <add key="OverstayMediumHours" value="9" />
    <!-- Continuous working days without weekly off -->
    <add key="ConsecutiveWeeklyOffDays" value="6" />
    <!-- Continuous working days treated as high risk -->
    <add key="ConsecutiveHighRiskDays" value="10" />

    <!-- ===================== Files ===================== -->
    <!-- Relative paths are resolved against the folder of the executable -->
    <add key="OutputDirectory" value="Output" />
    <add key="LogDirectory" value="Logs" />

    <!-- ===================== Mail ===================== -->
    <add key="MailEnabled" value="true" />
    <add key="MailFrom" value="timeoffice.omq@tatasteel.com" />
    <!-- Main recipients: Mines Manager, HODs, Shift In-Charge, Time Office -->
    <add key="MailTo" value="timeoffice.omq@tatasteel.com" />
    <add key="MailCc" value="" />
    <!-- Department wise recipients for the CC of that department's rows.
         Format: DEPTCODE=mail1@x.com;mail2@x.com|DEPTCODE2=mail3@x.com -->
    <add key="DepartmentMailMap" value="" />
    <add key="MailSubjectPrefix" value="Attendance Violation" />
    <add key="MaxViolationRowsInMail" value="40" />

    <!-- SMTP. Leave SmtpHost blank to only drop .eml files into Output\MailDrop (dry run / testing) -->
    <add key="SmtpHost" value="" />
    <add key="SmtpPort" value="25" />
    <add key="SmtpEnableSsl" value="false" />
    <add key="SmtpUser" value="" />
    <!-- Prefer the ATT_MAIL_PASSWORD environment variable over storing the password here -->
    <add key="SmtpPassword" value="" />
  </appSettings>

</configuration>
